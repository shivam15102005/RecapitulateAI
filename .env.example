# Copy this file to .env. Keep provider keys server-side only.
# Provider fallback order: Gemini -> Groq -> OpenAI -> Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set OLLAMA_MODEL to enable the local Ollama fallback.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Express API port. Vite reads the same PORT value for its /api proxy.
PORT=4000

# Must be shorter than the frontend's 20-second request timeout.
# The server caps this value at 18.5 seconds to return diagnostics in time.
AI_PROVIDER_TIMEOUT_MS=18000

# Fault simulator is enabled automatically outside production.
ENABLE_FAULT_SIMULATOR=false
